# Plik .env tworzy i uzupełnia automatycznie ./run.sh — nie musisz go pisać ręcznie.
# Jest w .gitignore. Zrób kopię zapasową: bez klucza nie odczytasz zaszyfrowanych danych.

# Klucz szyfrowania (64 znaki hex): openssl rand -hex 32
DSCAN_ENCRYPTION_KEY=

# PostgreSQL uruchamiany przez docker compose
POSTGRES_USER=dscan
POSTGRES_PASSWORD=
POSTGRES_DB=dscan
# Port na hoście (5433, żeby nie kolidować z lokalnym PostgreSQL na 5432)
POSTGRES_PORT=5433

# 1 = ./run.sh uruchamia bazę w Dockerze; 0 = używasz własnej bazy z DSCAN_DATABASE_URL
USE_DOCKER_POSTGRES=1

# Adres bazy dla natywnie uruchomionego DScan
DSCAN_DATABASE_URL=postgres://dscan:HASLO@127.0.0.1:5433/dscan
